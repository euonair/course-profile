  "euonair:scope": {
    "@type": "euonair:ScopeStatement",
    "euonair:includedTopic": [
      "tokenization",
      "word embeddings",
      "attention and Transformer",
      "decoding",
      "prompting",
      "retrieval-augmented generation",
      "parameter-efficient fine-tuning",
      "evaluation of NLP systems"
    ],
    "euonair:excludedTopic": [
      "training large language models from scratch",
      "speech signal processing in depth",
      "linguistic theory beyond what NLP tasks need"
    ],
    "euonair:depthNote": {
      "@value": "Speech recognition and synthesis are covered as applications only; the mathematics of training at scale is treated conceptually.",
      "@language": "en"
    }
  },
