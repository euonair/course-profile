  "url": "https://example.edu/catalogue/NLP-3060",
  "description": [
    {
      "@value": "The module covers how computers process, understand and generate written and spoken language, from text data and classical models to Transformer-based language models. Students specify NLP tasks, build and adapt solutions with prompting, retrieval and fine-tuning, evaluate them with suitable metrics and decide how an application can be released responsibly. Lectures with integrated exercises are combined with paper reading and team mini-projects.",
      "@language": "en"
    }
  ],
  "abstract": {
    "@value": "From text data to language models: building, adapting and evaluating NLP applications.",
    "@language": "en"
  },
  "syllabusSections": [
    {
      "@type": "Syllabus",
      "position": 1,
      "name": "Language tasks, text data and tokenization",
      "timeRequired": "PT15H"
    },
    {
      "@type": "Syllabus",
      "position": 2,
      "name": "Baselines and classical models: classification, tagging, n-gram language models",
      "timeRequired": "PT15H"
    },
    {
      "@type": "Syllabus",
      "position": 3,
      "name": "Word embeddings and contextual representations",
      "timeRequired": "PT15H"
    },
    {
      "@type": "Syllabus",
      "position": 4,
      "name": "Attention and the Transformer architecture",
      "timeRequired": "PT20H"
    },
    {
      "@type": "Syllabus",
      "position": 5,
      "name": "Pretraining, decoding and post-training of language models",
      "timeRequired": "PT20H"
    },
    {
      "@type": "Syllabus",
      "position": 6,
      "name": "Prompting and checkable outputs",
      "timeRequired": "PT15H"
    },
    {
      "@type": "Syllabus",
      "position": 7,
      "name": "Retrieval-augmented generation and fine-tuning",
      "timeRequired": "PT20H"
    },
    {
      "@type": "Syllabus",
      "position": 8,
      "name": "Evaluation, agents and responsible release",
      "timeRequired": "PT30H"
    }
  ],
  "keywords": [
    "natural language processing",
    "language models",
    "Transformer",
    "prompting",
    "retrieval-augmented generation",
    "fine-tuning",
    "evaluation"
  ],
