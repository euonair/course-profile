  "teaches": [
    {
      "@id": "https://example.edu/course-units/NLP-3060#lo1",
      "@type": [
        "DefinedTerm",
        "euonair:LearningOutcome"
      ],
      "termCode": "LO1",
      "description": [
        {
          "@value": "Specify an NLP task so that it can be tested — inputs, permitted outputs, success criterion and behaviour when information is missing — and explain what a reported score supports.",
          "@language": "en"
        },
        {
          "@value": "Eine NLP-Aufgabe so spezifizieren, dass sie prüfbar ist — Eingaben, zulässige Ausgaben, Erfolgskriterium und Verhalten bei fehlender Information — und erläutern, was ein berichteter Kennwert belegt.",
          "@language": "de"
        }
      ],
      "euonair:cognitiveLevel": {
        "@id": "euvoc:cognitive-level/apply"
      },
      "euonair:competenceCategory": {
        "@id": "euvoc:competence-category/skills"
      },
      "euonair:contributesTo": {
        "@id": "https://example.edu/programmes/bsc-artificial-intelligence#plo2"
      }
    },
    {
      "@id": "https://example.edu/course-units/NLP-3060#lo2",
      "@type": [
        "DefinedTerm",
        "euonair:LearningOutcome"
      ],
      "termCode": "LO2",
      "description": {
        "@value": "Explain how a Transformer language model turns text into predictions, from tokenization and embeddings through attention to decoding.",
        "@language": "en"
      },
      "euonair:cognitiveLevel": {
        "@id": "euvoc:cognitive-level/understand"
      },
      "euonair:competenceCategory": {
        "@id": "euvoc:competence-category/knowledge"
      }
    },
    {
      "@id": "https://example.edu/course-units/NLP-3060#lo3",
      "@type": [
        "DefinedTerm",
        "euonair:LearningOutcome"
      ],
      "termCode": "LO3",
      "description": {
        "@value": "Implement and adapt NLP solutions with common libraries using prompting, retrieval-augmented generation or fine-tuning, and justify the chosen approach.",
        "@language": "en"
      },
      "euonair:cognitiveLevel": {
        "@id": "euvoc:cognitive-level/apply"
      },
      "euonair:competenceCategory": {
        "@id": "euvoc:competence-category/skills"
      },
      "euonair:relatedSkill": {
        "@id": "http://data.europa.eu/esco/skill/PLACEHOLDER",
        "@type": "DefinedTerm",
        "name": "(ESCO skill to be selected; placeholder)",
        "inDefinedTermSet": "ESCO"
      }
    },
    {
      "@id": "https://example.edu/course-units/NLP-3060#lo4",
      "@type": [
        "DefinedTerm",
        "euonair:LearningOutcome"
      ],
      "termCode": "LO4",
      "description": {
        "@value": "Evaluate NLP systems with metrics matched to the claim, paired comparisons and subgroup tests, and interpret the results critically.",
        "@language": "en"
      },
      "euonair:cognitiveLevel": {
        "@id": "euvoc:cognitive-level/evaluate"
      },
      "euonair:competenceCategory": {
        "@id": "euvoc:competence-category/skills"
      },
      "euonair:contributesTo": {
        "@id": "https://example.edu/programmes/bsc-artificial-intelligence#plo4"
      }
    },
    {
      "@id": "https://example.edu/course-units/NLP-3060#lo5",
      "@type": [
        "DefinedTerm",
        "euonair:LearningOutcome"
      ],
      "termCode": "LO5",
      "description": {
        "@value": "Decide on the release of an NLP application in a decision memo that weighs performance, cost, privacy and the people affected.",
        "@language": "en"
      },
      "euonair:cognitiveLevel": {
        "@id": "euvoc:cognitive-level/evaluate"
      },
      "euonair:competenceCategory": {
        "@id": "euvoc:competence-category/responsibility-autonomy"
      },
      "euonair:relatedSkill": {
        "@type": "DefinedTerm",
        "name": "4.2 Protecting personal data and privacy",
        "inDefinedTermSet": "DigComp 2.2"
      }
    }
  ],
